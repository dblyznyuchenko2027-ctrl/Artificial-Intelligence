# Скопіюйте цей файл у .env. Ключ доступу — той самий, що в ПР3–ПР10:
# перенесіть його з тамтешнього .env.
# Файл .env до репозиторію не потрапляє — ключ доступу є секретом.

# ---- Провайдер (ПР10) ----

# Хто відповідає на запити: `openai` — справжній OpenAI-сумісний API
# (нижче), `mock` — підставний провайдер з app/providers/mock.py, що
# працює без ключа й уміє збоїти на вимогу. Застосунок має запускатися
# з будь-яким значенням.
LLM_PROVIDER=openai

# Запасний варіант, якщо основний провайдер не впорався після всіх
# спроб: `none` — повернути помилку; `mock` — підставний провайдер;
# інша назва моделі — та сама адреса й ключ, інша модель.
LLM_FALLBACK=none

# ---- Мовна модель (як у ПР3–ПР10) ----

# Адреса OpenAI-сумісного ендпоінта Gemini. Змінювати не потрібно.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ключ із Google AI Studio: https://aistudio.google.com → Get API key
LLM_API_KEY=

# Назва моделі.
LLM_MODEL=gemini-3.8-flash

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=600

# ---- Надійність (ПР10) ----
# Ваші значення з ПР10 — перенесіть їх.

LLM_TIMEOUT=20
LLM_IDLE_TIMEOUT=8
LLM_TOTAL_TIMEOUT=45
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE=0.5
LLM_BACKOFF_MAX=8
LLM_MAX_CONCURRENT=2

# ---- Обмеження власного API (ПР10) ----

# Скільки чернеток за хвилину може замовити один клієнт сторінки. На час
# прогону eval/replay.py (двадцять замовлень поспіль) підніміть.
RATE_LIMIT_PER_MINUTE=10

# ---- Підставний провайдер (ПР10) ----

MOCK_FIRST_DELAY_MS=600
MOCK_DELAY_MS=40
MOCK_FAILURE_RATE=0
MOCK_FAILURE_KIND=unavailable

# ---- Журнал (ПР11) ----

# Файл журналу у форматі JSON lines (один запис — один рядок JSON) і
# рівень: DEBUG | INFO | WARNING | ERROR. Папка logs/ до репозиторію не
# потрапляє.
LOG_FILE=logs/app.jsonl
LOG_LEVEL=INFO

# ---- Ціни (ПР11) ----
# За мільйон токенів, у доларах. Значення орієнтовні — чинні дивіться
# на сторінці цін провайдера (для Gemini: ai.google.dev/gemini-api/docs/pricing).
# Безкоштовний рівень не скасовує розрахунку: рахуємо так, ніби платимо.

LLM_PRICE_INPUT_PER_1M=0.30
LLM_PRICE_OUTPUT_PER_1M=2.50
# Вхідні токени, які провайдер узяв зі свого кешу prompt. Порожньо —
# чверть ціни вхідних.
LLM_PRICE_CACHED_INPUT_PER_1M=

# Рахувати підставного провайдера за тими самими цінами — щоб бюджет і
# порівняння з кешем можна було перевірити без ключа. 0 — безкоштовно.
MOCK_BILLABLE=1

# ---- Кеш відповідей (ПР11) ----

# 1 — увімкнено, 0 — вимкнено. Порівняння з кешем і без — саме цим
# перемикачем.
CACHE_ENABLED=1
# Скільки секунд живе запис.
CACHE_TTL_SECONDS=3600
# Скільки записів тримати щонайбільше.
CACHE_MAX_ENTRIES=500
# Файл кешу в state/ (переживає перезапуск). Порожньо — лише в памʼяті.
CACHE_FILE=state/cache.json

# ---- Денний ліміт витрат (ПР11) ----

# Скільки доларів за добу може витратити весь застосунок.
BUDGET_DAILY_USD=1.00
# На якій частці ліміту попереджати оператора (0–1).
BUDGET_WARN_AT=0.8
# Файл зі станом лічильника — щоб перезапуск не «поповнював» бюджет.
BUDGET_FILE=state/budget.json
