# Скопіюйте цей файл у .env. Файл .env до репозиторію не потрапляє —
# ключ доступу є секретом.
#
# Змінні з цього файла завантажуються ПЕРШИМИ і мають перевагу над
# однойменними в pr11/.env і pr8/.env. Так можна змінити поведінку
# застосунків лише на час прогону — наприклад, увімкнути підставного
# провайдера, не торкаючись їхніх налаштувань.

# ---- Функції, які оцінюються ----

# Папки застосунків: відносно папки pr12 або абсолютні. Типово —
# сусідні папки репозиторію.
DRAFTS_APP_DIR=../pr11
AGENT_APP_DIR=../pr8

# Кеш відповідей ПР11 під час прогону: 0 — оминати (типово; інакше k
# спроб одного прикладу повернуть одну й ту саму відповідь), 1 — вмикати.
EVAL_USE_CACHE=0

# ---- Модель-суддя ----

# Адреса й ключ — ті самі, що в попередніх роботах. Модель — ІНША, ніж
# та, що складає чернетки (LLM_MODEL у pr11/.env): суддя схильний вище
# оцінювати тексти у власному стилі.
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_TIMEOUT=30

# ---- Лише для перевірки конвеєра без ключа ----

# Розкоментуйте, щоб обидва застосунки відповідали підставним
# провайдером (чернетка — reply_example прикладу). На моку проходження
# прикладів — не заслуга моделі; оцінювати — справжнім провайдером.
# LLM_PROVIDER=mock
